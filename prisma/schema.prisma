generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id               Int      @id @default(autoincrement())
  title            String
  slug             String   @unique
  excerpt          String?
  content          String
  category         String
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  featuredImage    String?
  featuredImageId  String?
  views Int @default(0)
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  filename    String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  publicId    String?
}

model Subscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}
